{
  "name": "llamacpp-inf-flow-web",
  "private": true,
  "type": "module",
  "scripts": {
    "schema": "ts-json-schema-generator --path src/trace/schema.ts --type TraceEvent --no-top-ref --strict-tuples --out src/trace/trace.schema.json",
    "typecheck": "tsc --noEmit -p .",
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "test:phase2": "playwright test tests/phase2.spec.ts",
    "test:phase3": "playwright test tests/phase3.spec.ts",
    "test:record": "playwright test tests/record.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "ajv": "^8.17.1",
    "ts-json-schema-generator": "^2.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "elkjs": "^0.12.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
